{
  "name": "@ledgerhq/lumen-ui-rnative",
  "version": "0.1.77",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LedgerHQ/lumen.git",
    "directory": "libs/ui-rnative"
  },
  "homepage": "https://lumen-ldls.vercel.app/",
  "bugs": {
    "url": "https://github.com/LedgerHQ/lumen/issues"
  },
  "keywords": [
    "react-native",
    "ui",
    "components",
    "design-system",
    "mobile"
  ],
  "sideEffects": false,
  "type": "module",
  "react-native": "./src/index.ts",
  "main": "./dist/module/index.js",
  "module": "./dist/module/index.js",
  "types": "./dist/typescript/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/typescript/src/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/module/index.js",
      "default": "./dist/module/index.js"
    },
    "./symbols": {
      "types": "./dist/typescript/src/lib/Components/symbols/index.d.ts",
      "react-native": "./src/lib/Components/symbols/index.ts",
      "import": "./dist/module/lib/Components/symbols/index.js",
      "default": "./dist/module/lib/Components/symbols/index.js"
    },
    "./styles": {
      "types": "./dist/typescript/src/styles/index.d.ts",
      "react-native": "./src/styles/index.ts",
      "import": "./dist/module/styles/index.js",
      "default": "./dist/module/styles/index.js"
    },
    "./visualization": {
      "types": "./dist/typescript/src/lib/Components/visualization/index.d.ts",
      "react-native": "./src/lib/Components/visualization/index.ts",
      "import": "./dist/module/lib/Components/visualization/index.js",
      "default": "./dist/module/lib/Components/visualization/index.js"
    },
    "./lottie": {
      "types": "./dist/typescript/src/lib/Components/lottie/index.d.ts",
      "react-native": "./src/lib/Components/lottie/index.ts",
      "import": "./dist/module/lib/Components/lottie/index.js",
      "default": "./dist/module/lib/Components/lottie/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "ai-rules",
    "!**/*.tsbuildinfo",
    "!**/*.test.*",
    "!**/*.stories.*",
    "!**/*.figma.*",
    "!**/*.mdx",
    "!**/__tests__",
    "!**/__mocks__",
    "!**/__fixtures__"
  ],
  "dependencies": {
    "@ledgerhq/lumen-utils-shared": "0.1.20",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "@gorhom/bottom-sheet": "^5.0.0",
    "@ledgerhq/lumen-design-core": "0.1.38",
    "react": "^19.0.0",
    "react-native": ">=0.81.6 <0.87",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "^4.0.0 || ^5.0.0",
    "react-native-svg": "^15.0.0",
    "react-native-worklets": ">=0.8.0 <0.11",
    "@sbaiahmed1/react-native-blur": "^4.5.5",
    "expo": ">=54.0.0",
    "expo-clipboard": "~8.0.8 || ^55.0.0 || ^56.0.0 || ^57.0.0",
    "expo-haptics": "~15.0.8 || ^55.0.0 || ^56.0.0 || ^57.0.0",
    "lottie-react-native": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    },
    "lottie-react-native": {
      "optional": true
    }
  },
  "nx": {
    "tags": [
      "scope:react-native",
      "type:ui"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "exclude": "**/{__tests__/**,__fixtures__/**,__mocks__/**,*.test.*,*.stories.*,*.figma.*,*.mdx}",
    "targets": [
      [
        "module",
        {
          "esm": true,
          "configFile": "./babel.config.bob.cjs"
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.lib.json"
        }
      ]
    ]
  }
}
