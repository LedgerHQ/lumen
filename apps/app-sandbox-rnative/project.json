{
  "name": "app-sandbox-rnative",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/app-sandbox-rnative/src",
  "targets": {
    "run-ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo run:ios",
        "cwd": "apps/app-sandbox-rnative"
      }
    },
    "run-android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo run:android",
        "cwd": "apps/app-sandbox-rnative"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo start",
        "cwd": "apps/app-sandbox-rnative"
      }
    },
    "prebuild": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo prebuild --clean",
        "cwd": "apps/app-sandbox-rnative"
      }
    },
    "test:bundle": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "commands": [
          "npx expo export --platform ios --output-dir dist --source-maps --no-bytecode",
          "node tests/bundle/verify-bundle.mjs"
        ],
        "cwd": "apps/app-sandbox-rnative",
        "parallel": false
      },
      "dependsOn": [
        "^build"
      ]
    }
  },
  "tags": [
    "scope:react-native"
  ]
}