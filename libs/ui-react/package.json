{
  "name": "@ledgerhq/lumen-ui-react",
  "version": "0.1.52",
  "license": "Apache-2.0",
  "sideEffects": false,
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "tailwind",
    "base-ui"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./tailwind.css": "./tailwind.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./symbols": {
      "types": "./dist/lib/Components/symbols/index.d.ts",
      "import": "./dist/lib/Components/symbols/index.js",
      "default": "./dist/lib/Components/symbols/index.js"
    },
    "./*": "./dist/lib/Components/core/*/index.js"
  },
  "files": [
    "dist",
    "ai-rules",
    "tailwind.css",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "tags": [
      "scope:react",
      "type:ui"
    ]
  },
  "dependencies": {
    "@ledgerhq/lumen-utils-shared": "0.1.10",
    "i18next": "^23.7.0",
    "react-i18next": "^14.0.0"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.3.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "@tanstack/react-table": "^8.21.3",
    "@ledgerhq/lumen-design-core": "0.1.24",
    "clsx": "^2.1.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^2.6.0"
  }
}
