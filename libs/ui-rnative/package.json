{
  "name": "@ledgerhq/lumen-ui-rnative",
  "version": "0.1.60",
  "license": "Apache-2.0",
  "keywords": [
    "react-native",
    "ui",
    "components",
    "design-system",
    "mobile"
  ],
  "sideEffects": false,
  "type": "module",
  "react-native": "./src/index.ts",
  "main": "./dist/module/index.js",
  "module": "./dist/module/index.js",
  "types": "./dist/typescript/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/typescript/src/index.d.ts",
      "import": "./dist/module/index.js",
      "default": "./dist/module/index.js"
    },
    "./symbols": {
      "react-native": "./src/lib/Components/symbols/index.ts",
      "types": "./dist/typescript/src/lib/Components/symbols/index.d.ts",
      "import": "./dist/module/lib/Components/symbols/index.js",
      "default": "./dist/module/lib/Components/symbols/index.js"
    },
    "./styles": {
      "react-native": "./src/styles/index.ts",
      "types": "./dist/typescript/src/styles/index.d.ts",
      "import": "./dist/module/styles/index.js",
      "default": "./dist/module/styles/index.js"
    },
    "./visualization": {
      "react-native": "./src/lib/Components/visualization/index.ts",
      "types": "./dist/typescript/src/lib/Components/visualization/index.d.ts",
      "import": "./dist/module/lib/Components/visualization/index.js",
      "default": "./dist/module/lib/Components/visualization/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "ai-rules",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@ledgerhq/lumen-utils-shared": "0.1.12",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "i18next": "^23.7.0",
    "react-i18next": "^14.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "@gorhom/bottom-sheet": "^5.0.0",
    "@ledgerhq/lumen-design-core": "0.1.28",
    "react": "^19.0.0",
    "react-native": "~0.81.6",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": "^4.1.0",
    "react-native-safe-area-context": "^4.0.0 || ^5.0.0",
    "react-native-svg": "^15.0.0",
    "react-native-worklets": ">=0.5.0",
    "@sbaiahmed1/react-native-blur": "^4.5.5",
    "expo": ">=54.0.0",
    "expo-haptics": "~15.0.8"
  },
  "peerDependenciesMeta": {
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "nx": {
    "tags": [
      "scope:react-native",
      "type:ui"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "module",
        {
          "esm": true,
          "configFile": "./babel.config.bob.cjs"
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.lib.json"
        }
      ]
    ]
  }
}
