{
  "name": "@ledgerhq/lumen-migrations",
  "version": "0.0.5",
  "description": "Migration guides for Lumen updates, read by the automated upgrade pipeline in consumer repos.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LedgerHQ/lumen.git",
    "directory": "libs/migrations"
  },
  "homepage": "https://lumen-ldls.vercel.app/",
  "bugs": {
    "url": "https://github.com/LedgerHQ/lumen/issues"
  },
  "type": "module",
  "files": [
    "cli",
    "!cli/**/*.test.js",
    "!cli/fixtures.js",
    "src/*.md",
    "index.json",
    "index.d.cts"
  ],
  "bin": {
    "lumen-migrations": "./cli/bin.js"
  },
  "exports": {
    "./index.json": {
      "types": "./index.d.cts",
      "default": "./index.json"
    },
    "./package.json": "./package.json",
    "./*.md": "./src/*.md"
  },
  "nx": {
    "tags": [
      "scope:shared",
      "type:tooling"
    ]
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
