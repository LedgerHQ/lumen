{
  "name": "sync-figma",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "internals/sync-figma/src",
  "projectType": "library",
  "tags": [
    "scope:internal",
    "type:tooling"
  ],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest --run",
        "cwd": "internals/sync-figma"
      }
    },
    "extract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx internals/sync-figma/src/cli.ts extract"
      }
    },
    "code-syntax": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx internals/sync-figma/src/cli.ts code-syntax"
      }
    },
    "design-tokens-etl": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx internals/sync-figma/src/automations/designTokensEtl.ts"
      }
    },
    "generate-symbols-react": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx internals/sync-figma/src/automations/generate-symbols.mts --templatePath libs/ui-react/src/lib/Components/symbols/utils/icon-template.ts --outputPath libs/ui-react/src/lib/Components/symbols"
      }
    },
    "generate-symbols-react-native": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx internals/sync-figma/src/automations/generate-symbols.mts --templatePath libs/ui-rnative/src/lib/Components/symbols/utils/icon-template.ts --outputPath libs/ui-rnative/src/lib/Components/symbols --isReactNative true"
      }
    }
  }
}
