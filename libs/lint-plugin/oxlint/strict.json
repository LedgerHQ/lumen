{
  "jsPlugins": [
    {
      "name": "better-tailwindcss",
      "specifier": "../src/plugins/better-tailwindcss.js"
    },
    { "name": "shadcn", "specifier": "../src/plugins/shadcn.js" }
  ],
  "rules": {
    "better-tailwindcss/enforce-consistent-class-order": "error",
    "better-tailwindcss/enforce-consistent-line-wrapping": "off",
    "better-tailwindcss/no-deprecated-classes": "error",
    "better-tailwindcss/no-duplicate-classes": "error",
    "better-tailwindcss/no-unnecessary-whitespace": "error",
    "better-tailwindcss/enforce-canonical-classes": "error",
    "better-tailwindcss/no-concatenated-classes": "error",
    "better-tailwindcss/no-conflicting-classes": "error",
    "better-tailwindcss/no-unknown-classes": "error",
    "better-tailwindcss/enforce-logical-properties": [
      "error",
      {
        "ignore": [
          "^(?:.*:)?!?-?(?:(?:scroll-)?[mp][tb]|top|bottom|border-[tb]|(?:min-|max-)?[wh]|size)(?:-|$)",
          "^(?:.*:)?!?-?left-(?:1/2|\\[50%\\])$"
        ]
      }
    ],
    "better-tailwindcss/no-restricted-classes": [
      "error",
      {
        "restrict": [
          {
            "pattern": "^((?:.*:)?!?-?)left-(?!(?:1/2|\\[50%\\])$)(.+)$",
            "fix": "$1start-$2",
            "message": "\"$0\" stays on the left in right-to-left locales: use \"$1start-$2\"."
          },
          {
            "pattern": "^((?:.*:)?!?-?)right-(.+)$",
            "fix": "$1end-$2",
            "message": "\"$0\" stays on the right in right-to-left locales: use \"$1end-$2\"."
          }
        ]
      }
    ],
    "shadcn/no-arbitrary-values": [
      "warn",
      {
        "allow": [
          "transition-*",
          "grid-rows-*",
          "grid-cols-*",
          "translate-*",
          "bg-linear-*",
          "top-[50%]",
          "left-[50%]",
          "rounded-[inherit]",
          "max-w-[calc(*",
          "w-[calc(*",
          "[-webkit-mask-clip:no-clip]"
        ],
        "componentImports": ["^@ledgerhq/lumen-ui-react(/|$)"]
      }
    ],
    "shadcn/no-inline-styles": "warn",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "tailwind-merge",
            "message": "Use cn from '@ledgerhq/lumen-design-core/cn': it joins classes like clsx and resolves conflicts between Lumen classes, which plain tailwind-merge misreads."
          },
          {
            "name": "clsx",
            "message": "Use cn from '@ledgerhq/lumen-design-core/cn': it joins classes like clsx and resolves conflicts between Lumen classes, which plain tailwind-merge misreads."
          },
          {
            "name": "classnames",
            "message": "Use cn from '@ledgerhq/lumen-design-core/cn': it joins classes like clsx and resolves conflicts between Lumen classes, which plain tailwind-merge misreads."
          }
        ]
      }
    ]
  }
}
