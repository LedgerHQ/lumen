{
  "name": "app-sandbox-react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/app-sandbox-react/src",
  "targets": {
    "test:tree-shaking": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/tests/treeShaking/dist",
        "{projectRoot}/tests/treeShaking/dist-visualization"
      ],
      "options": {
        "commands": [
          "vite build --config tests/treeShaking/vite.treeshaking.config.ts",
          "node tests/treeShaking/verify-bundle.mjs --profile=main --dist=dist",
          "vite build --config tests/treeShaking/vite.visualization.config.ts",
          "node tests/treeShaking/verify-bundle.mjs --profile=visualization --dist=dist-visualization"
        ],
        "cwd": "apps/app-sandbox-react",
        "parallel": false
      },
      "dependsOn": [
        "^build"
      ]
    }
  },
  "tags": [
    "scope:react"
  ]
}
