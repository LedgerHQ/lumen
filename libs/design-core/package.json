{
  "name": "@ledgerhq/lumen-design-core",
  "version": "0.1.37",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LedgerHQ/lumen.git",
    "directory": "libs/design-core"
  },
  "homepage": "https://lumen-ldls.vercel.app/",
  "bugs": {
    "url": "https://github.com/LedgerHQ/lumen/issues"
  },
  "keywords": [
    "design-system",
    "tailwind",
    "figma"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "import": "./dist/cn.js",
      "default": "./dist/cn.js"
    },
    "./symbols/*": "./symbols/icons/*",
    "./themes/*": "./themes/*"
  },
  "files": [
    "dist",
    "symbols",
    "themes",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.17",
    "tslib": "^2.3.0"
  }
}
