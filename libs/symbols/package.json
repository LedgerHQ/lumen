{
  "name": "@ledgerhq/lumen-symbols",
  "version": "0.0.2",
  "description": "Symbols for the Lumen design system, one import path per symbol.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LedgerHQ/lumen.git",
    "directory": "libs/symbols"
  },
  "homepage": "https://lumen-ldls.vercel.app/",
  "bugs": {
    "url": "https://github.com/LedgerHQ/lumen/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    "./lotties/*": {
      "types": "./dist/lotties/*.d.ts",
      "import": "./dist/lotties/*.js",
      "default": "./dist/lotties/*.js"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "scope:shared",
      "type:assets"
    ]
  }
}
